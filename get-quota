#!/usr/bin/env bash
set -eu

CONTRACT=2
ROUTE="/v0/resource/plugins/pi-bridge/usage"
DEFAULT_VAULT_CMD='secret-tool lookup Title "cliproxyapi api key"'
VAULT_CMD="${CLIPROXY_QUOTA_VAULT_CMD-$DEFAULT_VAULT_CMD}"
CACHE_TTL_SECONDS=60
PI_CONFIG="${CLIPROXY_QUOTA_PI_CONFIG:-$HOME/.pi/agent/pi-cliproxyapi/config.json}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cliproxy-quota"

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

emit_bare() {
    jq -cn --arg status "$1" --arg error "$2" \
        '{status: $status, error: $error, stale: true, anyProblem: false, drift: false, providers: []}'
    exit 0
}

trim() {
    printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

resolve_value() {
    local raw
    raw=$(trim "$1")
    case "$raw" in
        '!'*) trim "$(sh -c "${raw#!}" 2>/dev/null || true)" ;;
        '$'*) printenv "${raw#$}" || true ;;
        *)    printf '%s' "$raw" ;;
    esac
}

endpoint=$(trim "${CLIPROXY_QUOTA_ENDPOINT:-}")
if [ -z "$endpoint" ] && [ -f "$PI_CONFIG" ]; then
    endpoint=$(jq -r '.proxy.endpoint // empty' "$PI_CONFIG" 2>/dev/null || true)
fi

key=""
if [ -n "$VAULT_CMD" ]; then
    key=$(trim "$(sh -c "$VAULT_CMD" 2>/dev/null || true)")
fi
if [ -z "$key" ] && [ -f "$PI_CONFIG" ]; then
    raw_key=$(jq -r '.proxy.apiKey // empty' "$PI_CONFIG" 2>/dev/null || true)
    [ -n "$raw_key" ] && key=$(resolve_value "$raw_key")
fi
if [ -z "$key" ]; then
    key=$(trim "${CLIPROXY_QUOTA_KEY:-}")
fi

[ -n "$endpoint" ] || emit_bare "no-endpoint" "no endpoint configured"
[ -n "$key" ] || emit_bare "no-key" "key unavailable"

origin=$(printf '%s' "$endpoint" | sed -E 's#^([Hh][Tt][Tt][Pp][Ss]?://[^/?\#]+).*#\1#')
url="${origin}${ROUTE}"
[ "$FORCE" = "1" ] && url="${url}?refresh=1"

CACHE_FILE="$CACHE_DIR/output-$(printf '%s' "$origin" | sha256sum | cut -c1-16).json"

if [ "$FORCE" = "0" ] && [ -f "$CACHE_FILE" ]; then
    now=$(date +%s)
    mtime=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || stat -f %m "$CACHE_FILE")
    if [ $((now - mtime)) -lt "$CACHE_TTL_SECONDS" ]; then
        cat "$CACHE_FILE"
        exit 0
    fi
fi

mkdir -p "$CACHE_DIR"
body_file=$(mktemp)
header_file=$(mktemp)
out_file=$(mktemp "$CACHE_DIR/.out.XXXXXX")
trap 'rm -f "$body_file" "$header_file" "$out_file"' EXIT

http_code=$(curl -sS -m 15 \
    -H "Authorization: Bearer $key" \
    -H "X-Pi-Contract: $CONTRACT" \
    -D "$header_file" -o "$body_file" -w "%{http_code}" \
    "$url" 2>/dev/null) || emit_bare "unreachable" "proxy unreachable"

case "$http_code" in
    200) : ;;
    404) emit_bare "no-plugin" "server has no quota plugin (pi-bridge)" ;;
    *)   emit_bare "http-error" "proxy returned HTTP $http_code" ;;
esac

contract_latest=$(tr -d '\r' < "$header_file" \
    | awk -F': ' 'tolower($1) == "x-pi-contract-latest" {print $2}' | tail -1)

if ! jq -e '.schemaVersion and (.accounts | type == "array")' "$body_file" >/dev/null 2>&1; then
    emit_bare "http-error" "unexpected payload shape"
fi

HIST_FILE="$CACHE_DIR/history-$(printf '%s' "$origin" | sha256sum | cut -c1-16).jsonl"
now_ts=$(date +%s)
hist_writable=1
if command -v flock >/dev/null 2>&1; then
    exec 9>"$HIST_FILE.lock"
    flock -w 2 9 || hist_writable=0
fi
if [ "$hist_writable" = "1" ]; then
    snapshot=$(jq -c --argjson ts "$now_ts" '
        . as $doc |
        {
            ts: $ts,
            providers: ([.accounts[] | {provider, success: (.success // 0), failed: (.failed // 0)}]
                | group_by(.provider)
                | map(.[0] as $first | {
                    provider: $first.provider,
                    success: ([.[].success] | add),
                    failed: ([.[].failed] | add),
                    tokens: ([($doc.models // [])[] | select(.provider == $first.provider)]
                        | map({key: .model, value: (.total // 0)}) | from_entries)
                }))
        }' "$body_file")
    hist_tmp=$(mktemp "$CACHE_DIR/.hist.XXXXXX")
    { [ -f "$HIST_FILE" ] && cat "$HIST_FILE"; printf '%s\n' "$snapshot"; } \
        | jq -c --argjson cutoff $((now_ts - 8 * 86400)) 'select(.ts >= $cutoff)' > "$hist_tmp" \
        && mv "$hist_tmp" "$HIST_FILE"
fi

activity=$(jq -s '
    [ .[] | .ts as $ts | .providers[]
      | {provider, day: ($ts | strflocaltime("%Y-%m-%d")), ts: $ts,
         success, failed, tokens: (.tokens // {})} ]
    | group_by(.provider)
    | map({
        key: .[0].provider,
        value: (group_by(.day) | map(max_by(.ts)) | sort_by(.day)
            | . as $days
            | [ range(1; ($days | length)) as $i
                | ($days[$i].tokens) as $cur
                | ($days[$i - 1].tokens) as $prev
                | {
                    date: $days[$i].day,
                    requests: ([($days[$i].success - $days[$i - 1].success), 0] | max),
                    failed: ([($days[$i].failed - $days[$i - 1].failed), 0] | max),
                    tokens: ([ ($cur | keys_unsorted[]), ($prev | keys_unsorted[]) ] | unique
                        | map({key: ., value: ([($cur[.] // 0) - ($prev[.] // 0), 0] | max)})
                        | from_entries
                        | with_entries(select(.value > 0)))
                } ]
            | .[-7:])
    })
    | from_entries' "$HIST_FILE" 2>/dev/null) || activity="{}"

jq -c --arg contractLatest "${contract_latest:-}" --argjson contract "$CONTRACT" --argjson activity "$activity" '
    def live: (.disabled | not) and (.unavailable | not) and .supported
              and ((.groups // []) | length > 0);
    def bottleneck: [.groups[].remainingFraction] | min;
    def window_seconds:
        .windowSeconds // (
            ((.label // "") | capture("^(?<n>[0-9]+)\\s*(?<u>[smhdw])"; "i") // null)
            | if . == null then null
              else (.n | tonumber) * ({s: 1, m: 60, h: 3600, d: 86400, w: 604800}[.u | ascii_downcase])
              end
        );
    def group_view: {id, label, remainingFraction, resetTime: (.resetTime // null), windowSeconds: window_seconds};
    def troubled: .disabled or .unavailable
                  or ((.supported != false) and (.status != "active"));
    . as $doc |
    {
        status: "ok",
        error: "",
        stale: (.cache.stale // false),
        updatedAt: (.cache.updatedAt // .generatedAt // null),
        generatedAt: (.generatedAt // null),
        payloadSchema: .schemaVersion,
        contractLatest: (if $contractLatest == "" then null else ($contractLatest | tonumber) end),
        anyProblem: ([.accounts[] | troubled] | any),
        drift: (($contractLatest != "" and (($contractLatest | tonumber) > $contract))
                or (.schemaVersion != 1)),
        unsupportedProviders: (.unsupportedProviders // []),
        providers: (
            ($doc.accounts | map(.provider)
             | reduce .[] as $p ([]; if index($p) then . else . + [$p] end))
            | map(. as $p |
                ([$doc.accounts[] | select(.provider == $p) | select(live)] | max_by(bottleneck)) as $win | {
                provider: $p,
                aggregate: (if $win then ($win | bottleneck) else null end),
                aggregateGroups: (if $win then [$win.groups[] | group_view] else [] end),
                activity: ($activity[$p] // []),
                problem: ([$doc.accounts[] | select(.provider == $p) | troubled] | any),
                accounts: [$doc.accounts[] | select(.provider == $p) | {
                    account, label, status, disabled, unavailable, supported,
                    success, failed, lastRequestAt,
                    error: (.error // ""),
                    noQuota: ((.groups // []) | length == 0),
                    groups: [(.groups // [])[] | group_view]
                }]
            })
        )
    }
' "$body_file" > "$out_file" || emit_bare "http-error" "unexpected payload shape"

cat "$out_file"
mv "$out_file" "$CACHE_FILE"
