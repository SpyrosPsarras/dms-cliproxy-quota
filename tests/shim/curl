#!/usr/bin/env bash
set -eu

: "${SHIM_DIR:?SHIM_DIR must be set}"
stdin=""
for a in "$@"; do [ "$a" = "@-" ] && stdin=$(cat); done
echo "$* | stdin: $stdin" >> "$SHIM_DIR/calls.log"

status="${SHIM_STATUS:-200}"
out_file=""
header_file=""
write_out=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
        -o) out_file="${args[i+1]}" ;;
        -D) header_file="${args[i+1]}" ;;
        -w) write_out="${args[i+1]}" ;;
    esac
done

if [ -z "$out_file" ] || [ -z "$header_file" ] || [ "$write_out" != "%{http_code}" ]; then
    echo "shim: missing or malformed -D/-o/-w usage: $*" >&2
    exit 64
fi

if [ -n "$header_file" ]; then
    if [ -n "${SHIM_HEADERS_FILE:-}" ]; then
        cat "$SHIM_HEADERS_FILE" > "$header_file"
    else
        printf 'HTTP/2 %s\r\nx-pi-contract: 2\r\nx-pi-contract-latest: 2\r\n\r\n' "$status" > "$header_file"
    fi
fi

if [ -n "$out_file" ] && [ "$status" = "200" ]; then
    cat "${SHIM_BODY_FILE:?SHIM_BODY_FILE must be set}" > "$out_file"
fi

if [ "${SHIM_FAIL:-0}" = "1" ]; then
    exit 7
fi
printf '%s' "$status"
